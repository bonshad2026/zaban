# Copy this file to .env and fill in the values. .env is never committed to git.
# Save .env as UTF-8 without a BOM. A BOM at the start makes the first name (SECRET_KEY) unreadable.
# Do not leave a number or address empty: an empty value is read as "" and the app stops at start.

# ---- Required on the server ----

# Long random values. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# The password of the PostgreSQL user "zaban" (the database is "zaban", the host is "db" inside Docker).
POSTGRES_PASSWORD=

# production on the server, development only on your own computer. In production SECRET_KEY must be set.
ENVIRONMENT=production

# The public address of the website with https, without a slash at the end. Used for the payment return address.
PUBLIC_BASE_URL=https://your-domain.example

# Password for the admin page (/admin). Without it nobody can sign in to the admin page.
ADMIN_PASSWORD=

# SMS codes for adult sign-in (Kavenegar). The template must be approved by Kavenegar and contain one token for the code.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=zaban-otp
OTP_TTL_SECONDS=60

# Payments. "fake" is for testing only and must not be used with real payments. "zarinpal" needs the merchant ID.
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=

# ---- AI replies (optional) ----

# anthropic or openai. Leave the key empty to run in offline mode, which costs nothing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ZABAN_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Prices in USD per million tokens, from the price list of the provider you use.
PRICE_INPUT_PER_MTOK=1.0
PRICE_OUTPUT_PER_MTOK=5.0

# ---- Sessions ----

# Session lengths in seconds
SESSION_TOKEN_TTL=900
WEB_SESSION_TTL=43200

# ---- Website ----

# Port on the server for the website. Default: 8020.
ZABAN_PORT=8020

# Contact details shown on the contact page. Leave empty to hide them.
CONTACT_PHONE=
CONTACT_EMAIL=

# Websites allowed to call the conversation API from a browser, comma separated (for example https://learn.example.com).
CONVERSATION_ALLOWED_ORIGINS=
