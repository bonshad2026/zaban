# Copy this file to .env and fill in the values. .env is never committed to git.

# Required. Use long random values. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
POSTGRES_PASSWORD=

# development or production. In production, SECRET_KEY must be set.
ENVIRONMENT=development

# Optional. Leave empty to skip the Claude API (offline mode).
ANTHROPIC_API_KEY=
ZABAN_MODEL=claude-haiku-5-5

# Optional demo data for local testing. Leave empty to create no demo accounts.
ZABAN_DEMO_API_KEY=
ZABAN_DEMO_PARENT_PHONE=
ZABAN_DEMO_STUDENT_USERNAME=
ZABAN_DEMO_STUDENT_PASSWORD=

# SMS codes for adult sign-in (Kavenegar). Required in production. The template must be approved by Kavenegar
# and contain one token for the code.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=zaban-otp
OTP_TTL_SECONDS=120

# Session lengths in seconds
SESSION_TOKEN_TTL=900
WEB_SESSION_TTL=43200

# Placeholder prices in USD per million tokens. Set the real values from Anthropic's price list.
PRICE_INPUT_PER_MTOK=1.0
PRICE_OUTPUT_PER_MTOK=5.0

# Port on this computer for the zaban website (see docs/ports.md). Default: 8020.
ZABAN_PORT=8020

# Contact details shown on the contact page. Leave empty to hide them.
CONTACT_PHONE=
CONTACT_EMAIL=

# Websites allowed to call the conversation API from a browser, comma separated (for example https://learn.example.com).
CONVERSATION_ALLOWED_ORIGINS=
